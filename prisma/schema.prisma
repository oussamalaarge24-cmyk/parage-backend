// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`
// output   = "../generated/prisma"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Lot {
  id         Int     @id @default(autoincrement())
  certificat String
  espece     String?
  taille     String?
  createdAt  DateTime @default(now())
  Production Production[]
  PoidsCuit  PoidsCuit[]
}

enum Role {
  admin
  chef
  pesee
  reception
  reception_stock
  pointage
  direction
  rh
  stock
}

/* ===========================================================
   STOCK / RÉCEPTIONS / MOUVEMENTS (nouveau module)
   Tables API: bags, certificats, entree, sortie
   =========================================================== */

model BagStock {
  id        Int      @id @default(autoincrement())
  numBag    String   @unique
  poidsTare Float    @default(0)
  dateSaisie String?
  createdAt DateTime @default(now())

  @@map("bags")
}

model CertificatStock {
  id              Int      @id @default(autoincrement())
  certificat      String
  numContenaire   String?
  numCamion       String?
  poidsReceptionne Float   @default(0)
  dateSaisie      String?
  createdAt       DateTime @default(now())

  entrees EntreeStock[]

  @@index([certificat])
  @@map("certificats")
}

model EntreeStock {
  id            Int      @id @default(autoincrement())
  dateEntree    String
  heure         String?

  numBag        String
  poids         Float    @default(0)   // brut
  poidsTare     Float    @default(0)
  poidsNet      Float    @default(0)

  taille        String?
  espece        String?

  // lien optionnel vers la ligne certificat+camion, pour historique / cohérence
  idCertificat  Int?
  certificat    String?
  numContenaire String?
  numCamion     String?

  createdAt     DateTime @default(now())

  Certificat CertificatStock? @relation(fields: [idCertificat], references: [id], onDelete: SetNull)
  sorties    SortieStock[]

  @@index([numBag])
  @@index([certificat])
  @@map("entree")
}

model SortieStock {
  id          Int      @id @default(autoincrement())
  dateSortie  String

  idEntreeRef Int
  numBag      String
  certificat  String?
  numContenaire String?
  numCamion   String?
  taille      String?
  espece      String?

  createdAt   DateTime @default(now())

  Entree EntreeStock @relation(fields: [idEntreeRef], references: [id], onDelete: Cascade)

  @@index([dateSortie])
  @@index([numBag])
  @@map("sortie")
}

model PoidsCuit {
  id             Int     @id @default(autoincrement())
  dateProduction String
  heure          String?
  groupe         Int
  idLot          Int?
  certificat     String?
  espece         String?
  taille         String?
  numeroChariot  Int?
  poidsGrille    Float   @default(0)
  createdAt      DateTime @default(now())

  Lot Lot? @relation(fields: [idLot], references: [id])
}

model Dechets {
  id             Int     @id @default(autoincrement())
  dateProduction String
  heure          String?
  groupe         Int
  numeroBag      Int?
  poidsTare      Float   @default(0)
  poidsNet       Float   @default(0)
  createdAt      DateTime @default(now())
}

model Operatrice {
  id        Int     @id @default(autoincrement())
  nomPrenom String
  matricule String?
  num       String
  groupe    Int
  services  String?
  createdAt DateTime @default(now())

  Production Production[]

  @@unique([num, groupe])
}

model Production {
  id            Int     @id @default(autoincrement())
  dateSaisie    String
  dateProduction String
  heure         String?
  idOperatrice  Int
  idLot         Int?
  poidsFilet    Float   @default(0)
  nombreCaisse  Int     @default(0)
  groupe        Int
  createdAt     DateTime @default(now())

  Operatrice Operatrice @relation(fields: [idOperatrice], references: [id])
  Lot        Lot?       @relation(fields: [idLot], references: [id])
}

model Heures {
  id             Int     @id @default(autoincrement())
  dateSaisie     String
  dateProduction String
  groupe         Int
  num            String
  nomPrenom      String?
  entree1        String?
  sortie1        String?
  entree2        String?
  sortie2        String?
  entree3        String?
  sortie3        String?
  heures         Float   @default(0)
  createdAt      DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  nom       String
  username  String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
}

model MoyenFrais {
  id             Int     @id @default(autoincrement())
  groupe         Int
  dateProduction String
  moyenFrais     Float   @default(0)
  totalFrais     Float   @default(0)
  createdAt      DateTime @default(now())
}
